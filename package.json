{
  "name": "chibatakumi-portfolio-root",
  "private": true,
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "packages/film-lab-core",
    "packages/film-lab-renderer",
    "packages/film-lab-ui",
    "packages/film-lab-smart-look",
    "packages/gpu-2.5d-presets",
    "packages/gpu-film-post",
    "packages/gpu-fx-presets",
    "packages/motion-core",
    "packages/motion-dot",
    "packages/motion-grid",
    "packages/motion-flow",
    "packages/design-system",
    "packages/webgpu-motion-art",
    "packages/webgpu-motion-audio",
    "packages/webgpu-motion-dom",
    "packages/webgpu-motion-input",
    "packages/webgpu-motion-post",
    "packages/webgpu-motion-scene",
    "packages/webgpu-motion-shell",
    "packages/webgpu-motion-ui",
    "apps/capacitor-film-lab-ios",
    "apps/web",
    "apps/remotion-film-lab",
    "apps/desktop-film-lab-batch",
    "apps/tauri-film-lab-webview-spike"
  ],
  "scripts": {
    "dev": "bun run build:core && bun run build:renderer && bun run --cwd apps/web dev",
    "dev:web": "bun run build:core && bun run build:renderer && bun run --cwd apps/web dev",
    "dev:ios": "bun run build:core && bun run generate:filmtone-ios-swift && bun run --cwd apps/capacitor-film-lab-ios dev",
    "open:ios": "./scripts/open-filmtone-ios.sh",
    "bench": "bun run scripts/aggregate-benchmark.ts benchmark/runs/",
    "bench:append": "bun run scripts/append-benchmark-row.ts",
    "bench:sample": "bun run scripts/aggregate-benchmark.ts benchmark/samples/",
    "dev:desktop": "bun run --cwd apps/desktop-film-lab-batch dev",
    "dev:context": "bun run --cwd apps/web dev:context",
    "build:web": "bun run build:core && bun run build:renderer && bun run --cwd apps/web build",
    "build:ios": "bun run build:core && bun run generate:filmtone-ios-swift && bun run --cwd apps/capacitor-film-lab-ios build && bun run --cwd apps/capacitor-film-lab-ios cap:sync:ios",
    "start:web": "bun run --cwd apps/web start",
    "build:core": "bun run --cwd packages/film-lab-core build",
    "generate:filmtone-ios-swift": "bun run scripts/generate-filmtone-ios-swift.ts",
    "build:renderer": "bun run --cwd packages/film-lab-renderer build",
    "build:smart-look": "bun run --cwd packages/film-lab-smart-look build",
    "typecheck:desktop": "bun run --cwd apps/desktop-film-lab-batch tsc -p tsconfig.json --noEmit",
    "typecheck:shared": "sh ./scripts/typecheck-shared.sh",
    "verify:desktop": "sh ./scripts/verify-desktop.sh",
    "verify:ios": "sh ./scripts/verify-ios.sh",
    "postinstall": "bun run build:core && bun run build:renderer && bun run build:smart-look",
    "verify:film-lab-surfaces": "bun run --cwd apps/web build && bun run --cwd apps/desktop-film-lab-batch test:smart-look-pending"
  }
}
