{
  "name": "chibatakumi-portfolio-root",
  "private": true,
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "packages/film-lab-core",
    "packages/film-lab-renderer",
    "packages/film-lab-ui",
    "packages/film-lab-smart-look",
    "apps/web",
    "apps/remotion-film-lab",
    "apps/desktop-film-lab-batch",
    "apps/tauri-film-lab-webview-spike"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:context": "bun run --cwd apps/web dev:context",
    "build:web": "bun run --cwd apps/web build",
    "start:web": "bun run --cwd apps/web start",
    "build:core": "bun run --cwd packages/film-lab-core build",
    "build:renderer": "bun run --cwd packages/film-lab-renderer build",
    "build:smart-look": "bun run --cwd packages/film-lab-smart-look build",
    "postinstall": "bun run build:core && bun run build:renderer && bun run build:smart-look",
    "verify:film-lab-surfaces": "bun run --cwd apps/web build && bun run --cwd apps/desktop-film-lab-batch test:smart-look-pending"
  }
}
