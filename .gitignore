# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# Workspace-local installs (nested packages are not covered by root /node_modules)
packages/**/node_modules/

/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# macOS Native Desktop v2 — xcodebuild output
apps/filmtone-desktop-macos/build/
**/xcuserdata/
**/*.xcuserstate
**/DerivedData/

# macOS Phase 1b parity outputs
/test-out/

# misc
.DS_Store
*.pem
*.p8
*.p12
*.cer
*.key
*.provisionprofile

# Local agent / browser tooling (never commit)
.playwright-cli/
.claude/settings.local.json

# Nested `git worktree` checkouts under this repo (do not add to parent index)
.worktrees/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
