default_platform(:mac)

require "fileutils"
require "shellwords"
require "tmpdir"

APP_ROOT = File.expand_path("..", __dir__)
FASTLANE_DIR = __dir__
REPO_ROOT = File.expand_path("../..", APP_ROOT)
PROJECT = File.join(APP_ROOT, "FilmtoneDesktop.xcodeproj", "project.pbxproj")
METADATA_TEMPLATE_PATH = File.join(FASTLANE_DIR, "metadata")
SCREENSHOTS_PATH = File.join(FASTLANE_DIR, "screenshots")
GENERATED_PATH = File.join(FASTLANE_DIR, ".generated")
APP_IDENTIFIER = "com.chibatakumi.film-lab-desktop"
APP_PLATFORM = "osx"
DEFAULT_CANONICAL_BASE_URL = "https://www.chibatakumi.studio"
DEFAULT_REVIEW_FIRST_NAME = "Takumi"
DEFAULT_REVIEW_LAST_NAME = "Chiba"
DEFAULT_REVIEW_EMAIL = "chiba@fores-tone.co.jp"
METADATA_LOCALES = ["ja", "en-US"].freeze
SCREENSHOT_LOCALES = ["ja", "en-US"].freeze

def normalized_env(name)
  value = ENV[name]
  return nil if value.nil?

  stripped = value.strip
  stripped.empty? ? nil : stripped
end

def truthy_env?(name)
  %w[1 true yes on].include?(ENV[name].to_s.downcase)
end

def env!(name)
  value = normalized_env(name)
  UI.user_error!("Missing required environment variable #{name}") if value.nil?
  value
end

def project_setting!(name)
  values = File.read(PROJECT).scan(/#{Regexp.escape(name)} = ([^;]+);/).flatten.map(&:strip).uniq
  UI.user_error!("Expected one #{name} in #{PROJECT}, found #{values.join(', ')}") unless values.one?

  values.first.delete_prefix('"').delete_suffix('"')
end

def macos_marketing_version!
  normalized_env("APP_VERSION") || project_setting!("MARKETING_VERSION")
end

def macos_build_number!
  normalized_env("BUILD_NUMBER") || project_setting!("CURRENT_PROJECT_VERSION")
end

def asc_api_key_configured?
  normalized_env("ASC_KEY_ID") &&
    normalized_env("ASC_ISSUER_ID") &&
    (normalized_env("ASC_KEY_CONTENT") || normalized_env("ASC_KEY_PATH"))
end

def resolve_candidate_path(value)
  expanded = File.expand_path(value)
  return expanded if value.start_with?("/") && File.exist?(expanded)

  candidate_roots = [
    APP_ROOT,
    REPO_ROOT,
    normalized_env("FILMTONE_IOS_RELEASE_ENV_ROOT"),
  ].compact

  candidate_roots.each do |root|
    candidate = File.expand_path(value, root)
    return candidate if File.exist?(candidate)
  end

  File.expand_path(value, APP_ROOT)
end

def resolve_existing_path!(value, label:)
  path = resolve_candidate_path(value)
  UI.user_error!("#{label} not found at #{path}") unless File.exist?(path)

  path
end

def load_asc_api_key!
  UI.user_error!(
    "Set ASC_KEY_ID, ASC_ISSUER_ID, and either ASC_KEY_CONTENT or ASC_KEY_PATH"
  ) unless asc_api_key_configured?

  options = {
    key_id: env!("ASC_KEY_ID"),
    issuer_id: env!("ASC_ISSUER_ID"),
    duration: 1200,
  }

  if (key_content = normalized_env("ASC_KEY_CONTENT"))
    options[:key_content] = key_content.gsub("\\n", "\n")
  else
    options[:key_filepath] = resolve_existing_path!(env!("ASC_KEY_PATH"), label: "ASC_KEY_PATH")
  end

  app_store_connect_api_key(**options)
end

def with_altool_private_key!
  UI.user_error!(
    "Set ASC_KEY_ID, ASC_ISSUER_ID, and either ASC_KEY_CONTENT or ASC_KEY_PATH"
  ) unless asc_api_key_configured?

  key_id = env!("ASC_KEY_ID")
  issuer_id = env!("ASC_ISSUER_ID")

  Dir.mktmpdir do |dir|
    private_keys_dir = File.join(dir, "private_keys")
    FileUtils.mkdir_p(private_keys_dir)
    key_path = File.join(private_keys_dir, "AuthKey_#{key_id}.p8")

    if (key_content = normalized_env("ASC_KEY_CONTENT"))
      File.write(key_path, key_content.gsub("\\n", "\n"))
    else
      FileUtils.cp(resolve_existing_path!(env!("ASC_KEY_PATH"), label: "ASC_KEY_PATH"), key_path)
    end
    File.chmod(0o600, key_path)

    Dir.chdir(dir) do
      yield(key_id, issuer_id)
    end
  end
end

def localized_env_key(prefix, locale)
  "#{prefix}_#{locale.tr("-", "_").upcase}"
end

def localized_url(prefix, locale, default_value)
  normalized_env(localized_env_key(prefix, locale)) ||
    normalized_env(prefix) ||
    default_value
end

def marketing_url_for(locale)
  base_url = normalized_env("FILMTONE_CANONICAL_BASE_URL") || DEFAULT_CANONICAL_BASE_URL
  default_path = locale == "ja" ? "/filmtone" : "/en/filmtone"
  localized_url("FILMTONE_MARKETING_URL", locale, "#{base_url}#{default_path}")
end

def support_url_for(locale)
  base_url = normalized_env("FILMTONE_CANONICAL_BASE_URL") || DEFAULT_CANONICAL_BASE_URL
  default_path = locale == "ja" ? "/filmtone/support" : "/en/filmtone/support"
  localized_url("FILMTONE_SUPPORT_URL", locale, "#{base_url}#{default_path}")
end

def privacy_url_for(locale)
  base_url = normalized_env("FILMTONE_CANONICAL_BASE_URL") || DEFAULT_CANONICAL_BASE_URL
  default_path = locale == "ja" ? "/filmtone/privacy" : "/en/filmtone/privacy"
  localized_url("FILMTONE_PRIVACY_URL", locale, "#{base_url}#{default_path}")
end

def read_text_if_present(path)
  return nil unless File.exist?(path)

  value = File.read(path).strip
  value.empty? ? nil : value
end

def localized_release_note_texts
  METADATA_LOCALES.each_with_object({}) do |locale, memo|
    text = read_text_if_present(File.join(METADATA_TEMPLATE_PATH, locale, "release_notes.txt"))
    memo[locale] = text if text
  end
end

def localized_metadata_texts(filename)
  METADATA_LOCALES.each_with_object({}) do |locale, memo|
    text = read_text_if_present(File.join(METADATA_TEMPLATE_PATH, locale, filename))
    memo[locale] = text if text
  end
end

def localized_store_metadata_options
  {
    name: localized_metadata_texts("name.txt"),
    subtitle: localized_metadata_texts("subtitle.txt"),
    keywords: localized_metadata_texts("keywords.txt"),
    promotional_text: localized_metadata_texts("promotional_text.txt"),
    description: localized_metadata_texts("description.txt"),
    release_notes: localized_release_note_texts,
  }.reject { |_, value| value.empty? }
end

def stage_metadata!
  staged_path = File.join(GENERATED_PATH, "metadata")
  FileUtils.rm_rf(staged_path)
  FileUtils.mkdir_p(staged_path)
  FileUtils.cp_r(Dir.glob(File.join(METADATA_TEMPLATE_PATH, "*")), staged_path)

  METADATA_LOCALES.each do |locale|
    locale_dir = File.join(staged_path, locale)
    FileUtils.mkdir_p(locale_dir)
    File.write(File.join(locale_dir, "marketing_url.txt"), "#{marketing_url_for(locale)}\n")
    File.write(File.join(locale_dir, "support_url.txt"), "#{support_url_for(locale)}\n")
    File.write(File.join(locale_dir, "privacy_url.txt"), "#{privacy_url_for(locale)}\n")
  end

  staged_path
end

def app_review_information!
  {
    first_name: normalized_env("REVIEW_FIRST_NAME") || DEFAULT_REVIEW_FIRST_NAME,
    last_name: normalized_env("REVIEW_LAST_NAME") || DEFAULT_REVIEW_LAST_NAME,
    phone_number: env!("REVIEW_PHONE"),
    email_address: normalized_env("REVIEW_EMAIL") || DEFAULT_REVIEW_EMAIL,
    demo_user: normalized_env("REVIEW_DEMO_USER"),
    demo_password: normalized_env("REVIEW_DEMO_PASSWORD"),
    notes: normalized_env("REVIEW_NOTES") ||
      "Filmtone Desktop is local-first. Review the flow by opening a still image or video, choosing a Look, adjusting Quick controls, Source Profile, and LUT strength, comparing before/after, then exporting to a user-selected folder. No login, subscription, AI generation, or cloud sync is required.",
  }.compact
end

def default_pkg_path
  File.join(APP_ROOT, "build", "app-store", project_setting!("MARKETING_VERSION"), "export", "Filmtone.pkg")
end

def explicit_pkg_path!(options, lane:)
  explicit_path = options[:pkg] || options["pkg"] || normalized_env("PKG_PATH")
  pkg_path = explicit_path ? resolve_candidate_path(explicit_path) : default_pkg_path

  UI.user_error!(
    "Set PKG_PATH, pass pkg:..., or run BUILD_MAS_PKG=1 fastlane mac #{lane} to create the default MAS package first."
  ) if pkg_path.nil? || !File.exist?(pkg_path)

  pkg_path
end

def staged_release_screenshot_paths
  SCREENSHOT_LOCALES.each_with_object({}) do |locale, memo|
    memo[locale] = Dir.glob(File.join(SCREENSHOTS_PATH, locale, "*.{png,jpg,jpeg}")).sort
  end
end

def validate_release_screenshots!
  screenshot_paths = staged_release_screenshot_paths
  missing_locales = screenshot_paths.select { |_, paths| paths.empty? }.keys

  unless missing_locales.empty?
    UI.user_error!(
      "Missing staged screenshots for locales: #{missing_locales.join(', ')} under #{SCREENSHOTS_PATH}."
    )
  end

  counts = screenshot_paths.transform_values(&:count)
  count_summary = counts.map { |locale, count| "#{locale}=#{count}" }.join(", ")

  unless counts.values.all? { |count| count.between?(1, 10) }
    UI.user_error!("Each locale must have between 1 and 10 screenshots. Current counts: #{count_summary}")
  end

  unless counts.values.uniq.one?
    UI.user_error!("Screenshot counts differ by locale: #{count_summary}")
  end

  expected_basenames = nil
  screenshot_paths.each do |locale, paths|
    basenames = paths.map { |path| File.basename(path) }
    expected_basenames ||= basenames
    next if basenames == expected_basenames

    UI.user_error!(
      "Screenshot filenames must match across locales. #{locale} has #{basenames.join(', ')}."
    )
  end

  screenshot_paths
end

def run_command!(command, display_command: nil)
  UI.command(display_command || command.map(&:shellescape).join(" "))
  success = system(*command)
  raise "Command failed: #{command.join(' ')}" unless success
end

def build_mas_pkg_if_requested!
  return unless truthy_env?("BUILD_MAS_PKG")

  run_command!(["bash", File.join(REPO_ROOT, "scripts", "release-macos-app-store.sh"), macos_marketing_version!])
end

def submission_confirmed!
  UI.user_error!("Set SUBMIT_FOR_REVIEW=1 before submitting to review.") unless truthy_env?("SUBMIT_FOR_REVIEW")
  UI.user_error!("Set CONFIRM_METADATA_READY=1 after confirming metadata, screenshots, App Privacy, and review contact details.") unless truthy_env?("CONFIRM_METADATA_READY")
end

def common_store_options
  {
    api_key: load_asc_api_key!,
    app_identifier: APP_IDENTIFIER,
    app_version: macos_marketing_version!,
    platform: APP_PLATFORM,
    metadata_path: stage_metadata!,
    force: true,
    run_precheck_before_submit: false,
    precheck_include_in_app_purchases: false,
    copyright: File.read(File.join(METADATA_TEMPLATE_PATH, "copyright.txt")).strip,
    support_url: {
      "ja" => support_url_for("ja"),
      "en-US" => support_url_for("en-US"),
    },
    marketing_url: {
      "ja" => marketing_url_for("ja"),
      "en-US" => marketing_url_for("en-US"),
    },
    privacy_url: {
      "ja" => privacy_url_for("ja"),
      "en-US" => privacy_url_for("en-US"),
    },
    app_review_information: app_review_information!,
    submission_information: {
      export_compliance_uses_encryption: false,
    },
    **localized_store_metadata_options,
  }
end

platform :mac do
  desc "Print Mac App Store release environment readiness without secret values"
  lane :release_env do
    run_command!(["bash", File.join(APP_ROOT, "scripts", "release-env-status.sh")])
  end

  desc "Upload localized Mac App Store metadata and review information"
  lane :metadata do
    upload_to_app_store(
      **common_store_options,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: false,
      automatic_release: false
    )
  end

  desc "Upload a Mac App Store pkg without touching metadata or screenshots"
  lane :upload do |options|
    build_mas_pkg_if_requested!
    upload_to_app_store(
      api_key: load_asc_api_key!,
      app_identifier: APP_IDENTIFIER,
      platform: APP_PLATFORM,
      pkg: explicit_pkg_path!(options, lane: "upload"),
      skip_binary_upload: false,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
  end

  desc "Upload the Mac App Store pkg and metadata; screenshots are opt-in"
  lane :release do |options|
    build_mas_pkg_if_requested!
    submit_for_review = truthy_env?("SUBMIT_FOR_REVIEW")
    submission_confirmed! if submit_for_review

    screenshots_enabled = truthy_env?("UPLOAD_SCREENSHOTS")
    validate_release_screenshots! if screenshots_enabled

    upload_to_app_store(
      **common_store_options,
      pkg: explicit_pkg_path!(options, lane: "release"),
      skip_binary_upload: false,
      skip_metadata: false,
      screenshots_path: SCREENSHOTS_PATH,
      skip_screenshots: !screenshots_enabled,
      overwrite_screenshots: truthy_env?("OVERWRITE_SCREENSHOTS"),
      submit_for_review: submit_for_review,
      automatic_release: truthy_env?("AUTOMATIC_RELEASE")
    )
  end

  desc "Submit an already uploaded Mac App Store build without uploading a binary"
  lane :submit_review do |options|
    submission_confirmed!
    app_version = normalized_env("APP_VERSION") || options[:app_version] || macos_marketing_version!
    build_number = normalized_env("BUILD_NUMBER") || options[:build_number] || macos_build_number!

    upload_to_app_store(
      **common_store_options,
      app_version: app_version,
      build_number: build_number,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: true,
      automatic_release: truthy_env?("AUTOMATIC_RELEASE")
    )
  end

  desc "Check altool delivery status for a previously uploaded package"
  lane :status do
    delivery_id = env!("DELIVERY_ID")
    with_altool_private_key! do |key_id, issuer_id|
      run_command!(
        [
          "xcrun",
          "altool",
          "--build-status",
          "--delivery-id",
          delivery_id,
          "--api-key",
          key_id,
          "--api-issuer",
          issuer_id,
        ],
        display_command: "xcrun altool --build-status --delivery-id #{delivery_id.shellescape} --api-key <redacted> --api-issuer <redacted>"
      )
    end
  end

  desc "Print the current App Privacy automation boundary"
  lane :privacy do
    UI.important("App Privacy cannot be updated by this ASC API-key-only lane.")
    UI.message("Use fastlane with an authenticated Apple ID/Admin session or App Store Connect UI.")
    UI.message("Suggested answer for the current local-first macOS app is documented in fastlane/app_privacy.md.")
  end
end
