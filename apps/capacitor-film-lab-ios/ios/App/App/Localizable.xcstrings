    "filmtone.hdr.notice.body.hlg" : {
      "comment" : "v1.2 candidate: collapse to single body. Generic SSoT §5.2 text used for all three variants (pq / hlg / wideGamutUnknown) per terminology SSoT.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This environment may not be able to convert HDR video into a standard SDR video accurately. You can continue exporting, but brightness or color may look different in other apps. For color-critical exports, convert the clip to SDR in your camera app or editor before importing it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この環境では、HDR動画を標準のSDR動画として正確に変換できない場合があります。書き出しは続行できますが、他のアプリで見ると明るさや色が元動画と違って見えることがあります。正確な色で書き出したい場合は、カメラアプリや編集アプリでSDR動画に変換してから読み込んでください。"
          }
        }
      }
    },
    "filmtone.hdr.notice.body.pq" : {
      "comment" : "v1.2 candidate: collapse to single body. Generic SSoT §5.2 text used for all three variants (pq / hlg / wideGamutUnknown) per terminology SSoT.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This environment may not be able to convert HDR video into a standard SDR video accurately. You can continue exporting, but brightness or color may look different in other apps. For color-critical exports, convert the clip to SDR in your camera app or editor before importing it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この環境では、HDR動画を標準のSDR動画として正確に変換できない場合があります。書き出しは続行できますが、他のアプリで見ると明るさや色が元動画と違って見えることがあります。正確な色で書き出したい場合は、カメラアプリや編集アプリでSDR動画に変換してから読み込んでください。"
          }
        }
      }
    },
    "filmtone.hdr.notice.body.wideGamutUnknown" : {
      "comment" : "v1.2 candidate: collapse to single body. Generic SSoT §5.2 text used for all three variants (pq / hlg / wideGamutUnknown) per terminology SSoT.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This environment may not be able to convert HDR video into a standard SDR video accurately. You can continue exporting, but brightness or color may look different in other apps. For color-critical exports, convert the clip to SDR in your camera app or editor before importing it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この環境では、HDR動画を標準のSDR動画として正確に変換できない場合があります。書き出しは続行できますが、他のアプリで見ると明るさや色が元動画と違って見えることがあります。正確な色で書き出したい場合は、カメラアプリや編集アプリでSDR動画に変換してから読み込んでください。"
          }
        }
      }
    },
    "filmtone.hdr.notice.title" : {
      "extractionState" : "stale",
