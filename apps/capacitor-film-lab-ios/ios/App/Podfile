# 2026-05-09 React/Capacitor purge: Capacitor + CapacitorCordova pods
# removed. The App target no longer links any third-party iOS framework
# via CocoaPods. Podfile + workspace stay in place because fastlane
# `Fastfile` / `Snapfile` and `scripts/generate-help-comparison-assets.sh`
# hard-reference `App.xcworkspace`; converting to a project-only setup
# would touch the release pipeline and is deferred.
#
# Add new third-party iOS deps here (or preferably via SwiftPM directly
# in the Xcode project — Capacitor was the only reason CocoaPods was
# in the loop).

platform :ios, '17.0'
use_frameworks!

# Workaround retained from the prior Capacitor era — harmless without
# pods, kept so re-introducing pods later does not trip the legacy
# Cordova plugin caching pitfall.
install! 'cocoapods', :disable_input_output_paths => true

target 'App' do
  # No third-party pods. Add `pod '...'` here if a dep requires CocoaPods.
end
