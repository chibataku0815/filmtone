{
  "name": "capacitor-film-lab-ios",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.3",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cap:add:ios": "cap add ios",
    "cap:sync:ios": "cap sync ios",
    "ios:open": "cap open ios",
    "release:bundle:install": "./scripts/bundle.sh install",
    "release:archive": "./scripts/bundle.sh exec fastlane ios archive",
    "release:screenshots": "./scripts/bundle.sh exec fastlane ios screenshots",
    "release:metadata": "./scripts/bundle.sh exec fastlane ios metadata",
    "release:beta": "./scripts/bundle.sh exec fastlane ios beta \"ipa:${IPA_PATH:?Set IPA_PATH=build/fastlane/Filmtone.ipa}\"",
    "release:appstore": "./scripts/bundle.sh exec fastlane ios release \"ipa:${IPA_PATH:?Set IPA_PATH=build/fastlane/Filmtone.ipa}\""
  },
  "dependencies": {
    "@capacitor/core": "7.4.3",
    "@phosphor-icons/react": "^2.1.10",
    "film-lab-core": "workspace:*",
    "film-lab-ui": "workspace:*",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "@capacitor/ios": "7.4.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4",
    "typescript": "^5.7.2",
    "vite": "^8.0.2"
  }
}
