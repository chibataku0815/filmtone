def staged_release_screenshot_paths
  SCREENSHOT_LOCALES.each_with_object({}) do |locale, memo|
    memo[locale] = Dir.glob(File.join(SCREENSHOTS_PATH, locale, "*.{png,jpg,jpeg}")).sort
  end
end

def validate_release_screenshots!
  screenshot_paths = staged_release_screenshot_paths
  missing_locales = screenshot_paths.select { |_, paths| paths.empty? }.keys

  unless missing_locales.empty?
    UI.user_error!(
      "Missing staged screenshots for locales: #{missing_locales.join(', ')} under #{SCREENSHOTS_PATH}. Run `fastlane ios screenshots` first."
    )
  end

  counts = screenshot_paths.transform_values(&:count)
  count_summary = counts.map { |locale, count| "#{locale}=#{count}" }.join(", ")

  unless counts.values.all? { |count| count.between?(1, 10) }
    UI.user_error!("Each locale must have between 1 and 10 screenshots. Current counts: #{count_summary}")
  end

  unless counts.values.uniq.one?
    UI.user_error!("Screenshot counts differ by locale: #{count_summary}")
  end

  expected_basenames = nil
  screenshot_paths.each do |locale, paths|
    basenames = paths.map { |path| File.basename(path) }
    expected_basenames ||= basenames
    next if basenames == expected_basenames

    UI.user_error!(
      "Screenshot filenames must match across locales. #{locale} has #{basenames.join(', ')}."
    )
  end

  screenshot_paths
end

def app_store_field_count(text, metric)
  metric == :bytes ? text.bytesize : text.length
end

def validate_ipad_metadata!
  missing = []
  violations = []

  IPAD_SCREENSHOT_LOCALES.each do |locale|
    IPAD_METADATA_REQUIRED_FIELDS.each do |field|
      path = File.join(IPAD_METADATA_TEMPLATE_PATH, locale, "#{field}.txt")
      unless File.exist?(path)
        missing << path
        next
      end

      text = File.read(path).strip
      missing << path if text.empty?

      if (limit = APP_STORE_FIELD_LIMITS[field])
        metric, max = limit
        count = app_store_field_count(text, metric)
        violations << "#{path} exceeds #{max} #{metric}: #{count}" if count > max
      end

      IPAD_FORBIDDEN_COPY_PATTERNS.each do |pattern|
        violations << "#{path} contains forbidden App Store text: #{pattern.source}" if text.match?(pattern)
      end
    end
  end

  Dir.glob(File.join(IPAD_METADATA_TEMPLATE_PATH, "**", "*.txt")).each do |path|
    text = File.read(path)
    IPAD_FORBIDDEN_COPY_PATTERNS.each do |pattern|
      violations << "#{path} contains forbidden App Store text: #{pattern.source}" if text.match?(pattern)
    end
  end

  UI.user_error!("Missing iPad metadata fields: #{missing.join(', ')}") unless missing.empty?
  UI.user_error!("iPad metadata preflight failed:\n#{violations.uniq.join("\n")}") unless violations.empty?

  UI.message("Validated iPad metadata at #{IPAD_METADATA_TEMPLATE_PATH}")
end

def png_dimensions(path)
  File.open(path, "rb") do |file|
    signature = file.read(8)
    UI.user_error!("Expected PNG signature for #{path}") unless signature == "\x89PNG\r\n\x1A\n".b

    file.read(4)
    chunk_type = file.read(4)
    UI.user_error!("Expected IHDR chunk for #{path}") unless chunk_type == "IHDR"

    [file.read(4).unpack1("N"), file.read(4).unpack1("N")]
  end
end

def staged_ipad_screenshot_paths
  IPAD_SCREENSHOT_LOCALES.each_with_object({}) do |locale, memo|
    memo[locale] = Dir.glob(File.join(IPAD_SCREENSHOTS_PATH, locale, "*.png")).sort
  end
end

def validate_ipad_screenshots!
  screenshot_paths = staged_ipad_screenshot_paths
  missing_locales = screenshot_paths.select { |_, paths| paths.empty? }.keys

  unless missing_locales.empty?
    UI.user_error!(
      "Missing iPad screenshots for locales: #{missing_locales.join(', ')} under #{IPAD_SCREENSHOTS_PATH}."
    )
  end

  counts = screenshot_paths.transform_values(&:count)
  count_summary = counts.map { |locale, count| "#{locale}=#{count}" }.join(", ")
  unless counts.values.all? { |count| count == IPAD_SCREENSHOT_COUNT }
    UI.user_error!("Expected #{IPAD_SCREENSHOT_COUNT} iPad screenshots per locale. Current counts: #{count_summary}")
  end

  expected_basenames = nil
  screenshot_paths.each do |locale, paths|
    basenames = paths.map { |path| File.basename(path) }
    expected_basenames ||= basenames
    next if basenames == expected_basenames

    UI.user_error!("iPad screenshot filenames must match across locales. #{locale} has #{basenames.join(', ')}.")
  end

  screenshot_paths.each_value do |paths|
    paths.each do |path|
      width, height = png_dimensions(path)
      next if width == IPAD_SCREENSHOT_WIDTH && height == IPAD_SCREENSHOT_HEIGHT

      UI.user_error!(
        "Invalid iPad screenshot size for #{path}: #{width}x#{height}, expected #{IPAD_SCREENSHOT_WIDTH}x#{IPAD_SCREENSHOT_HEIGHT}."
      )
    end
  end

  UI.message("Validated iPad screenshots at #{IPAD_SCREENSHOTS_PATH}: #{count_summary}")
  screenshot_paths
end

def ipad_app_store_version!
  normalized_env("IPAD_APP_VERSION") ||
    normalized_env("APP_VERSION") ||
    IPAD_DEFAULT_NEXT_VERSION
end

def ipad_app_store_build_number!(options)
  normalized_env("IPAD_BUILD_NUMBER") ||
    normalized_env("BUILD_NUMBER") ||
    options[:build_number] ||
    options["build_number"] ||
    UI.user_error!("Set IPAD_BUILD_NUMBER, BUILD_NUMBER, or pass build_number:")
end

platform :ios do
  desc "Archive Filmtone with Xcode automatic signing and app-store export"
  lane :archive do
    FileUtils.mkdir_p(BUILD_OUTPUT_DIR)

    xcargs_parts = ["-allowProvisioningUpdates"]
    temp_key_path = nil

    if asc_api_key_configured?
      temp_key_path = resolve_asc_key_file_path! if normalized_env("ASC_KEY_CONTENT")
      key_file_path = temp_key_path || File.expand_path(env!("ASC_KEY_PATH"), APP_ROOT)
      xcargs_parts.concat(
        [
          "-authenticationKeyIssuerID", env!("ASC_ISSUER_ID"),
          "-authenticationKeyID", env!("ASC_KEY_ID"),
          "-authenticationKeyPath", key_file_path,
        ]
      )
    end

    xcargs = xcargs_parts.map(&:shellescape).join(" ")

    begin
      build_app(
        workspace: IOS_WORKSPACE,
        scheme: "App",
        clean: true,
        export_method: "app-store",
        output_directory: BUILD_OUTPUT_DIR,
        output_name: "Filmtone",
        build_path: BUILD_OUTPUT_DIR,
        xcargs: xcargs,
        export_options: {
          method: "app-store",
          signingStyle: "automatic",
          teamID: DEVELOPMENT_TEAM_ID,
        }
      )
    ensure
      FileUtils.rm_f(temp_key_path) if temp_key_path
    end
  end

  desc "Capture App Store screenshots with a deterministic UI test rail"
  lane :screenshots do
    UI.message(
      "Capturing common App Store assets from locale #{snapshot_capture_locale} on #{SCREENSHOT_SIMULATOR_DEVICE} (#{SCREENSHOT_SIMULATOR_UDID}) and staging them for #{SCREENSHOT_LOCALES.join(', ')}."
    )
    run_snapshot_ui_test!(locale: snapshot_capture_locale)
    stage_screenshots_for_release!(SCREENSHOT_SIMULATOR_DEVICE)
    validate_release_screenshots!
  end

  desc "Upload localized App Store metadata and review info"
  lane :metadata do
    upload_to_app_store(
      api_key: load_asc_api_key!,
      app_version: app_store_version_number!,
      metadata_path: stage_metadata!,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      copyright: File.read(File.join(METADATA_TEMPLATE_PATH, "copyright.txt")).strip,
      support_url: localized_support_urls,
      marketing_url: localized_marketing_urls,
      privacy_url: localized_privacy_urls,
      app_review_information: app_review_information!,
      submission_information: {
        export_compliance_uses_encryption: false,
      },
      **localized_store_metadata_options
    )
  end

  desc "Upload only localized What's New release notes"
  lane :release_notes do
    load_asc_api_key!
    version = target_app_store_version!(app_store_version_number!)
    UI.message("Updating only What's New for #{APP_IDENTIFIER} #{version.version_string} (#{version.app_version_state})")
    sync_release_notes_only!(version: version)
  end

  desc "Validate staged Filmtone Studio App Store assets without uploading"
  lane :ipad_preflight do
    validate_ipad_metadata!
    validate_ipad_screenshots!
    UI.success("iPad preflight passed for #{IPAD_APP_IDENTIFIER}. No upload was performed.")
  end

  desc "Upload Filmtone Studio metadata and screenshots without binary or review submission"
  lane :ipad_upload_assets do
    validate_ipad_metadata!
    validate_ipad_screenshots!

    app_version = ipad_app_store_version!
    UI.important(
      "Uploading Filmtone Studio App Store assets for #{IPAD_APP_IDENTIFIER} #{app_version}. No binary upload or review submission will be performed."
    )

    upload_to_app_store(
      api_key: load_asc_api_key!,
      app_identifier: IPAD_APP_IDENTIFIER,
      app_version: app_version,
      platform: "ios",
      metadata_path: IPAD_METADATA_TEMPLATE_PATH,
      screenshots_path: IPAD_SCREENSHOTS_PATH,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: false,
      force: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      copyright: File.read(File.join(IPAD_METADATA_TEMPLATE_PATH, "copyright.txt")).strip,
      submission_information: {
        export_compliance_uses_encryption: false,
      }
    )
  end

  desc "Upload Filmtone Studio binary, metadata, and screenshots to App Store Connect"
  lane :ipad_release do |options|
    ipa_path = explicit_ipad_ipa_path!(options, lane: "ipad_release")
    validate_ipad_metadata!
    validate_ipad_screenshots!

    app_version = ipad_app_store_version!
    UI.important("Uploading Filmtone Studio #{app_version} for #{IPAD_APP_IDENTIFIER}.")

    upload_to_app_store(
      api_key: load_asc_api_key!,
      app_identifier: IPAD_APP_IDENTIFIER,
      app_version: app_version,
      ipa: ipa_path,
      platform: "ios",
      metadata_path: IPAD_METADATA_TEMPLATE_PATH,
      screenshots_path: IPAD_SCREENSHOTS_PATH,
      skip_binary_upload: false,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: truthy_env?("SUBMIT_FOR_REVIEW"),
      automatic_release: truthy_env?("AUTOMATIC_RELEASE"),
      force: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      copyright: File.read(File.join(IPAD_METADATA_TEMPLATE_PATH, "copyright.txt")).strip,
      release_notes: localized_ipad_release_note_texts,
      app_review_information: ipad_app_review_information!,
      submission_information: {
        export_compliance_uses_encryption: false,
      }
    )
  end

  desc "Submit an already uploaded Filmtone Studio build without touching screenshots or binary"
  lane :ipad_submit_review do |options|
    app_version = ipad_app_store_version!
    build_number = ipad_app_store_build_number!(options)
    api_key = load_asc_api_key!

    version = target_ipad_app_store_version!(app_version)
    UI.message("Syncing iPad What's New before review submission for #{IPAD_APP_IDENTIFIER} #{version.version_string}")
    sync_ipad_release_notes_only!(version: version)

    upload_to_app_store(
      api_key: api_key,
      app_identifier: IPAD_APP_IDENTIFIER,
      app_version: app_version,
      build_number: build_number,
      platform: "ios",
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: truthy_env?("AUTOMATIC_RELEASE"),
      force: true,
      precheck_include_in_app_purchases: false,
      app_review_information: ipad_app_review_information!,
      submission_information: {
        export_compliance_uses_encryption: false,
      }
    )
  end

  desc "Upload only the App Store binary without metadata or screenshots"
  lane :release_binary do |options|
    ipa_path = explicit_ipa_path!(options, lane: "release_binary")
    upload_to_app_store(
      api_key: load_asc_api_key!,
      app_identifier: APP_IDENTIFIER,
      app_version: app_store_version_number!,
      ipa: ipa_path,
      platform: "ios",
      skip_binary_upload: false,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        export_compliance_uses_encryption: false,
      }
    )
  end

  desc "Submit the current build after syncing only What's New release notes"
  lane :submit_review_release_notes do
    api_key = load_asc_api_key!
    version = target_app_store_version!(app_store_version_number!)
    UI.message("Syncing only What's New before review submission for #{APP_IDENTIFIER} #{version.version_string}")
    sync_release_notes_only!(version: version)

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: app_store_version_number!,
      build_number: app_store_build_number!,
      platform: "ios",
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: truthy_env?("AUTOMATIC_RELEASE"),
      force: true,
      precheck_include_in_app_purchases: false,
      app_review_information: app_review_information!,
      submission_information: {
        export_compliance_uses_encryption: false,
      }
    )
  end

  desc "Upload an archive to TestFlight"
  lane :beta do |options|
    ipa_path = explicit_ipa_path!(options, lane: "beta")
    upload_options = {
      api_key: load_asc_api_key!,
      ipa: ipa_path,
      app_platform: "ios",
      skip_waiting_for_build_processing: truthy_env?("SKIP_WAITING_FOR_BUILD_PROCESSING"),
      distribute_external: false,
      notify_external_testers: false,
    }
    build_release_notes = localized_build_release_notes
    upload_options[:localized_build_info] = build_release_notes unless build_release_notes.empty?

    upload_to_testflight(**upload_options)
  end

  desc "Upload the app-store build, metadata, and screenshots to App Store Connect"
  lane :release do |options|
    ipa_path = explicit_ipa_path!(options, lane: "release")
    validate_release_screenshots!
    upload_options = {
      api_key: load_asc_api_key!,
      app_version: app_store_version_number!,
      ipa: ipa_path,
      metadata_path: stage_metadata!,
      skip_binary_upload: false,
      skip_metadata: false,
      submit_for_review: truthy_env?("SUBMIT_FOR_REVIEW"),
      automatic_release: truthy_env?("AUTOMATIC_RELEASE"),
      force: true,
      precheck_include_in_app_purchases: false,
      copyright: File.read(File.join(METADATA_TEMPLATE_PATH, "copyright.txt")).strip,
      support_url: localized_support_urls,
      marketing_url: localized_marketing_urls,
      privacy_url: localized_privacy_urls,
      app_review_information: app_review_information!,
      submission_information: {
        export_compliance_uses_encryption: false,
      },
      screenshots_path: SCREENSHOTS_PATH,
      skip_screenshots: false,
      overwrite_screenshots: truthy_env?("OVERWRITE_SCREENSHOTS"),
      **localized_store_metadata_options
    }

    upload_to_app_store(**upload_options)
  end

  desc "Submit an already uploaded App Store Connect build without touching screenshots or binary"
  lane :submit_review do |options|
    app_version = normalized_env("APP_VERSION") || options[:app_version]
    build_number = normalized_env("BUILD_NUMBER") || options[:build_number]

    UI.user_error!("Set APP_VERSION or pass app_version:") unless app_version
    UI.user_error!("Set BUILD_NUMBER or pass build_number:") unless build_number

    upload_to_app_store(
      api_key: load_asc_api_key!,
      app_identifier: APP_IDENTIFIER,
      app_version: app_version,
      build_number: build_number,
      platform: "ios",
      metadata_path: stage_metadata!,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: true,
      automatic_release: truthy_env?("AUTOMATIC_RELEASE"),
      force: true,
      precheck_include_in_app_purchases: false,
      copyright: File.read(File.join(METADATA_TEMPLATE_PATH, "copyright.txt")).strip,
      support_url: localized_support_urls,
      marketing_url: localized_marketing_urls,
      privacy_url: localized_privacy_urls,
      app_review_information: app_review_information!,
      submission_information: {
        export_compliance_uses_encryption: false,
      },
      **localized_store_metadata_options
    )
  end
end
