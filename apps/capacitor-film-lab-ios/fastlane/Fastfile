def normalized_env(name)
  value = ENV[name]
  return nil if value.nil?

  stripped = value.strip
  stripped.empty? ? nil : stripped
end

def truthy_env?(name)
  %w[1 true yes on].include?(ENV[name].to_s.downcase)
end

def env!(name)
  value = normalized_env(name)
  UI.user_error!("Missing required environment variable #{name}") if value.nil?
  value
end

def command_output!(*command)
  stdout, stderr, status = Open3.capture3(*command)
  return stdout if status.success?

  UI.user_error!("Command failed: #{command.shelljoin}\n#{stderr}")
end

def plist_value!(plist_path, key)
  command_output!("/usr/libexec/PlistBuddy", "-c", "Print :#{key}", plist_path).strip
end

def plist_integer_array!(plist_path, key)
  value = command_output!("/usr/libexec/PlistBuddy", "-c", "Print :#{key}", plist_path)
  value.scan(/^\s*(\d+)\s*$/).flatten.map(&:to_i)
end

def assert_plist_value!(plist_path:, key:, expected:, label:)
  actual = plist_value!(plist_path, key)
  return if actual == expected

  UI.user_error!(
    "#{label} identity mismatch for #{key}: expected #{expected.inspect}, got #{actual.inspect} in #{plist_path}"
  )
end

def verify_ipa_identity!(ipa_path, identity)
  temp_dir = Dir.mktmpdir("filmtone-ipa-identity-")
  command_output!("unzip", "-q", ipa_path, "-d", temp_dir)

  payload_dir = File.join(temp_dir, "Payload")
  app_path = File.join(payload_dir, identity[:app_bundle_name])
  forbidden_app_path = File.join(payload_dir, identity[:forbidden_app_bundle_name])

  if Dir.exist?(forbidden_app_path)
    UI.user_error!(
      "#{identity[:label]} IPA identity failed: found forbidden payload #{identity[:forbidden_app_bundle_name]} in #{ipa_path}"
    )
  end
  UI.user_error!(
    "#{identity[:label]} IPA identity failed: expected Payload/#{identity[:app_bundle_name]} in #{ipa_path}"
  ) unless Dir.exist?(app_path)

  info_plist = File.join(app_path, "Info.plist")
  UI.user_error!("Missing app Info.plist at #{info_plist}") unless File.exist?(info_plist)

  assert_plist_value!(plist_path: info_plist, key: "CFBundleExecutable", expected: identity[:executable], label: identity[:label])
  assert_plist_value!(plist_path: info_plist, key: "CFBundleIdentifier", expected: identity[:bundle_id], label: identity[:label])
  assert_plist_value!(plist_path: info_plist, key: "CFBundleDisplayName", expected: identity[:display_name], label: identity[:label])

  device_family = plist_integer_array!(info_plist, "UIDeviceFamily")
  unless device_family == identity[:device_family]
    UI.user_error!(
      "#{identity[:label]} IPA identity mismatch for UIDeviceFamily: expected #{identity[:device_family].inspect}, got #{device_family.inspect} in #{info_plist}"
    )
  end

  extension_path = File.join(app_path, "PlugIns", identity[:extension_bundle_name])
  UI.user_error!(
    "#{identity[:label]} IPA identity failed: expected PlugIns/#{identity[:extension_bundle_name]} in #{ipa_path}"
  ) unless Dir.exist?(extension_path)

  extension_info_plist = File.join(extension_path, "Info.plist")
  UI.user_error!("Missing extension Info.plist at #{extension_info_plist}") unless File.exist?(extension_info_plist)

  assert_plist_value!(
    plist_path: extension_info_plist,
    key: "CFBundleExecutable",
    expected: identity[:extension_executable],
    label: "#{identity[:label]} extension"
  )
  assert_plist_value!(
    plist_path: extension_info_plist,
    key: "CFBundleIdentifier",
    expected: identity[:extension_bundle_id],
    label: "#{identity[:label]} extension"
  )

  UI.success(
    "Verified #{identity[:label]} IPA identity: Payload/#{identity[:app_bundle_name]}, #{identity[:bundle_id]}, UIDeviceFamily=#{identity[:device_family].join(',')}"
  )
  ipa_path
ensure
  FileUtils.rm_rf(temp_dir) if temp_dir
end

def app_store_version_number!
  explicit_version = normalized_env("APP_VERSION")
  return explicit_version if explicit_version

  versions = File.read(IOS_PROJECT).scan(/MARKETING_VERSION = ([^;]+);/).flatten.uniq
  UI.user_error!("Expected one MARKETING_VERSION in #{IOS_PROJECT}, found #{versions.join(', ')}") unless versions.one?

  versions.first
end

def app_store_build_number!
  explicit_build = normalized_env("BUILD_NUMBER")
  return explicit_build if explicit_build

  builds = File.read(IOS_PROJECT).scan(/CURRENT_PROJECT_VERSION = ([^;]+);/).flatten.uniq
  UI.user_error!("Expected one CURRENT_PROJECT_VERSION in #{IOS_PROJECT}, found #{builds.join(', ')}") unless builds.one?

  builds.first
end

def iphone_archive_version!
  normalized_env("APP_VERSION") ||
    UI.user_error!("Set APP_VERSION when archiving the iPhone release rail")
end

def iphone_archive_build_number!
  normalized_env("BUILD_NUMBER") ||
    UI.user_error!("Set BUILD_NUMBER when archiving the iPhone release rail")
end

def asc_api_key_configured?
  normalized_env("ASC_KEY_ID") &&
    normalized_env("ASC_ISSUER_ID") &&
    (normalized_env("ASC_KEY_CONTENT") || normalized_env("ASC_KEY_PATH"))
end

def load_asc_api_key!
  UI.user_error!(
    "Set ASC_KEY_ID, ASC_ISSUER_ID, and either ASC_KEY_CONTENT or ASC_KEY_PATH"
  ) unless asc_api_key_configured?

  options = {
    key_id: env!("ASC_KEY_ID"),
    issuer_id: env!("ASC_ISSUER_ID"),
    duration: 1200,
  }

  if (key_content = normalized_env("ASC_KEY_CONTENT"))
    options[:key_content] = key_content.gsub("\\n", "\n")
  else
    options[:key_filepath] = File.expand_path(env!("ASC_KEY_PATH"), APP_ROOT)
  end

  app_store_connect_api_key(**options)
end

def resolve_asc_key_file_path!
  if (key_content = normalized_env("ASC_KEY_CONTENT"))
    key_id = env!("ASC_KEY_ID")
    temp_path = File.join(Dir.tmpdir, "AuthKey_#{key_id}_#{Process.pid}.p8")
    File.write(temp_path, key_content.gsub("\\n", "\n"))
    File.chmod(0o600, temp_path)
    temp_path
  else
    File.expand_path(env!("ASC_KEY_PATH"), APP_ROOT)
  end
end

def localized_env_key(prefix, locale)
  "#{prefix}_#{locale.tr("-", "_").upcase}"
end

def localized_url(prefix, locale, default_value)
  normalized_env(localized_env_key(prefix, locale)) ||
    normalized_env(prefix) ||
    default_value
end

def marketing_url_for(locale)
  base_url = normalized_env("FILMTONE_CANONICAL_BASE_URL") || DEFAULT_CANONICAL_BASE_URL
  default_path = locale == "ja" ? "/filmtone" : "/en/filmtone"
  localized_url("FILMTONE_MARKETING_URL", locale, "#{base_url}#{default_path}")
end

def support_url_for(locale)
  base_url = normalized_env("FILMTONE_CANONICAL_BASE_URL") || DEFAULT_CANONICAL_BASE_URL
  default_path = locale == "ja" ? "/filmtone/support" : "/en/filmtone/support"
  localized_url("FILMTONE_SUPPORT_URL", locale, "#{base_url}#{default_path}")
end

def privacy_url_for(locale)
  base_url = normalized_env("FILMTONE_CANONICAL_BASE_URL") || DEFAULT_CANONICAL_BASE_URL
  default_path = locale == "ja" ? "/filmtone/privacy" : "/en/filmtone/privacy"
  localized_url("FILMTONE_PRIVACY_URL", locale, "#{base_url}#{default_path}")
end

def localized_url_options(&resolver)
  METADATA_LOCALES.each_with_object({}) do |locale, memo|
    memo[locale] = resolver.call(locale)
  end
end

def localized_support_urls
  localized_url_options { |locale| support_url_for(locale) }
end

def localized_marketing_urls
  localized_url_options { |locale| marketing_url_for(locale) }
end

def localized_privacy_urls
  localized_url_options { |locale| privacy_url_for(locale) }
end

def read_text_if_present(path)
  return nil unless File.exist?(path)

  value = File.read(path).strip
  value.empty? ? nil : value
end

def localized_release_note_texts
  METADATA_LOCALES.each_with_object({}) do |locale, memo|
    text = read_text_if_present(File.join(METADATA_TEMPLATE_PATH, locale, "release_notes.txt"))
    memo[locale] = text if text
  end
end

def localized_ipad_release_note_texts
  IPAD_SCREENSHOT_LOCALES.each_with_object({}) do |locale, memo|
    text = read_text_if_present(File.join(IPAD_METADATA_TEMPLATE_PATH, locale, "release_notes.txt"))
    memo[locale] = text if text
  end
end

def localized_metadata_texts(filename)
  METADATA_LOCALES.each_with_object({}) do |locale, memo|
    text = read_text_if_present(File.join(METADATA_TEMPLATE_PATH, locale, filename))
    memo[locale] = text if text
  end
end

def localized_build_release_notes
  localized_release_note_texts.each_with_object({}) do |(locale, notes), memo|
    memo[locale] = { whats_new: notes }
  end
end

def localized_ipad_build_release_notes
  localized_ipad_release_note_texts.each_with_object({}) do |(locale, notes), memo|
    memo[locale] = { whats_new: notes }
  end
end

def target_app_store_version!(version_string)
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  UI.user_error!("Could not find App Store Connect app #{APP_IDENTIFIER}") unless app

  versions = app.get_app_store_versions(
    filter: { platform: Spaceship::ConnectAPI::Platform::IOS },
    includes: nil
  )
  version = versions.find { |candidate| candidate.version_string == version_string }

  unless version
    available = versions
      .sort_by { |candidate| Gem::Version.new(candidate.version_string) }
      .map { |candidate| "#{candidate.version_string}(#{candidate.app_version_state})" }
      .join(", ")
    UI.user_error!("Could not find iOS App Store version #{version_string}. Available: #{available}")
  end

  version
end

def target_ipad_app_store_version!(version_string)
  app = Spaceship::ConnectAPI::App.find(IPAD_APP_IDENTIFIER)
  UI.user_error!("Could not find App Store Connect app #{IPAD_APP_IDENTIFIER}") unless app

  versions = app.get_app_store_versions(
    filter: { platform: Spaceship::ConnectAPI::Platform::IOS },
    includes: nil
  )
  version = versions.find { |candidate| candidate.version_string == version_string }

  unless version
    available = versions
      .sort_by { |candidate| Gem::Version.new(candidate.version_string) }
      .map { |candidate| "#{candidate.version_string}(#{candidate.app_version_state})" }
      .join(", ")
    UI.user_error!("Could not find iPad App Store version #{version_string}. Available: #{available}")
  end

  version
end

def sync_release_notes_only!(version:)
  notes_by_locale = localized_release_note_texts
  UI.user_error!("No localized release_notes.txt files found under #{METADATA_TEMPLATE_PATH}") if notes_by_locale.empty?

  localizations = version.get_app_store_version_localizations
  notes_by_locale.each do |locale, notes|
    localization = localizations.find { |candidate| candidate.locale == locale }

    if localization
      if localization.whats_new.to_s == notes
        UI.message("Release notes already match for #{locale}")
      else
        localization.update(attributes: { whats_new: notes })
        UI.message("Updated release notes for #{locale}")
      end
    else
      version.create_app_store_version_localization(attributes: { locale: locale, whatsNew: notes })
      UI.message("Created release notes localization for #{locale}")
    end
  end
end

def sync_ipad_release_notes_only!(version:)
  notes_by_locale = localized_ipad_release_note_texts
  UI.user_error!("No localized release_notes.txt files found under #{IPAD_METADATA_TEMPLATE_PATH}") if notes_by_locale.empty?

  localizations = version.get_app_store_version_localizations
  notes_by_locale.each do |locale, notes|
    localization = localizations.find { |candidate| candidate.locale == locale }

    if localization
      if localization.whats_new.to_s == notes
        UI.message("iPad release notes already match for #{locale}")
      else
        localization.update(attributes: { whats_new: notes })
        UI.message("Updated iPad release notes for #{locale}")
      end
    else
      version.create_app_store_version_localization(attributes: { locale: locale, whatsNew: notes })
      UI.message("Created iPad release notes localization for #{locale}")
    end
  end
end

def sync_review_release_type!(version:)
  release_type = if truthy_env?("AUTOMATIC_RELEASE")
                   Spaceship::ConnectAPI::AppStoreVersion::ReleaseType::AFTER_APPROVAL
                 else
                   Spaceship::ConnectAPI::AppStoreVersion::ReleaseType::MANUAL
                 end
  return UI.message("Release type already matches #{release_type}") if version.release_type == release_type

  version.update(attributes: { "releaseType" => release_type })
  UI.message("Updated release type to #{release_type}")
end

def localized_store_metadata_options
  {
    name: localized_metadata_texts("name.txt"),
    subtitle: localized_metadata_texts("subtitle.txt"),
    keywords: localized_metadata_texts("keywords.txt"),
    promotional_text: localized_metadata_texts("promotional_text.txt"),
    description: localized_metadata_texts("description.txt"),
    release_notes: localized_release_note_texts,
  }.reject { |_, value| value.empty? }
end

def stage_metadata!
  staged_path = File.join(GENERATED_PATH, "metadata")
  FileUtils.rm_rf(staged_path)
  FileUtils.mkdir_p(staged_path)
  FileUtils.cp_r(Dir.glob(File.join(METADATA_TEMPLATE_PATH, "*")), staged_path)

  METADATA_LOCALES.each do |locale|
    locale_dir = File.join(staged_path, locale)
    FileUtils.mkdir_p(locale_dir)
    File.write(File.join(locale_dir, "marketing_url.txt"), "#{marketing_url_for(locale)}\n")
    File.write(File.join(locale_dir, "support_url.txt"), "#{support_url_for(locale)}\n")
    File.write(File.join(locale_dir, "privacy_url.txt"), "#{privacy_url_for(locale)}\n")
  end

  staged_path
end

def snapshot_capture_locale
  normalized_env("SNAPSHOT_BASE_LOCALE") || "ja"
end

def snapshot_language_for(locale)
  case locale
  when "ja"
    "ja"
  when "en-US"
    "en"
  else
    locale.split("-").first
  end
end

def snapshot_locale_identifier_for(locale)
  case locale
  when "ja"
    "ja_JP"
  when "en-US"
    "en_US"
  else
    locale.tr("-", "_")
  end
end

def run_command!(command)
  UI.command(command.map(&:shellescape).join(" "))
  success = system(*command)
  raise "Command failed: #{command.join(' ')}" unless success
end

def write_snapshot_cache!(locale:)
  FileUtils.mkdir_p(SCREENSHOT_CACHE_ROOT)
  FileUtils.rm_rf(SCREENSHOT_CACHE_PATH)
  File.write(File.join(SCREENSHOT_CACHE_ROOT, "language.txt"), "#{snapshot_language_for(locale)}\n")
  File.write(File.join(SCREENSHOT_CACHE_ROOT, "locale.txt"), "#{snapshot_locale_identifier_for(locale)}\n")
  File.write(File.join(SCREENSHOT_CACHE_ROOT, "snapshot-launch_arguments.txt"), "\n")
end

def run_snapshot_ui_test!(locale:)
  write_snapshot_cache!(locale: locale)
  run_command!(
    [
      "xcodebuild",
      "-workspace",
      IOS_WORKSPACE,
      "-scheme",
      "App",
      "-destination",
      "id=#{SCREENSHOT_SIMULATOR_UDID}",
      "CODE_SIGNING_ALLOWED=NO",
      "-only-testing:FilmtoneSnapshotsUITests/FilmtoneSnapshotsUITests/testCaptureAppStoreScreenshots",
      "test",
    ]
  )
end

def expected_screenshot_paths(device_name)
  SCREENSHOT_FILE_SUFFIXES.map do |suffix|
    File.join(SCREENSHOT_CACHE_PATH, "#{device_name}-#{suffix}.png")
  end
end

def stage_screenshots_for_release!(device_name)
  screenshot_paths = expected_screenshot_paths(device_name)
  missing_paths = screenshot_paths.reject { |path| File.exist?(path) }

  UI.user_error!(
    "Missing expected screenshots: #{missing_paths.join(', ')}"
  ) unless missing_paths.empty?

  SCREENSHOT_LOCALES.each do |locale|
    locale_dir = File.join(SCREENSHOTS_PATH, locale)
    FileUtils.rm_rf(locale_dir)
    FileUtils.mkdir_p(locale_dir)
    screenshot_paths.each do |path|
      FileUtils.cp(path, File.join(locale_dir, File.basename(path)))
    end
  end
end

def app_review_information!
  {
    first_name: normalized_env("REVIEW_FIRST_NAME") || DEFAULT_REVIEW_FIRST_NAME,
    last_name: normalized_env("REVIEW_LAST_NAME") || DEFAULT_REVIEW_LAST_NAME,
    phone_number: env!("REVIEW_PHONE"),
    email_address: normalized_env("REVIEW_EMAIL") || DEFAULT_REVIEW_EMAIL,
    demo_user: normalized_env("REVIEW_DEMO_USER"),
    demo_password: normalized_env("REVIEW_DEMO_PASSWORD"),
    notes: normalized_env("REVIEW_NOTES") ||
      "Filmtone is local-first. Review the flow by importing a photo or video, choosing a Look, adjusting Quick controls, optionally applying Source Profile and Film Look LUTs, then exporting and saving to Photos. No login, subscription, AI generation, or cloud sync is required.",
  }.compact
end

def explicit_ipa_path!(options, lane:)
  explicit_path = options[:ipa] || options["ipa"] || normalized_env("IPA_PATH")
  UI.user_error!(
    "Set IPA_PATH or pass ipa:... to `fastlane ios #{lane}`. Implicit archive fallback is disabled."
  ) if explicit_path.nil?

  ipa_path = File.expand_path(explicit_path, APP_ROOT)
  UI.user_error!("IPA not found at #{ipa_path}") unless File.exist?(ipa_path)
  verify_ipa_identity!(ipa_path, IPHONE_IPA_IDENTITY)
end

def explicit_ipad_ipa_path!(options, lane:)
  explicit_path =
    options[:ipa] ||
    options["ipa"] ||
    normalized_env("IPAD_IPA_PATH") ||
    normalized_env("IPA_PATH")

  UI.user_error!(
    "Set IPAD_IPA_PATH, IPA_PATH, or pass ipa:... to `fastlane ios #{lane}`. Implicit archive fallback is disabled."
  ) if explicit_path.nil?

  ipa_path = File.expand_path(explicit_path, APP_ROOT)
  UI.user_error!("iPad IPA not found at #{ipa_path}") unless File.exist?(ipa_path)
  verify_ipa_identity!(ipa_path, IPAD_IPA_IDENTITY)
end

def ipad_app_review_information!
  {
    first_name: normalized_env("REVIEW_FIRST_NAME") || DEFAULT_REVIEW_FIRST_NAME,
    last_name: normalized_env("REVIEW_LAST_NAME") || DEFAULT_REVIEW_LAST_NAME,
    phone_number: env!("REVIEW_PHONE"),
    email_address: normalized_env("REVIEW_EMAIL") || DEFAULT_REVIEW_EMAIL,
    demo_user: normalized_env("REVIEW_DEMO_USER"),
    demo_password: normalized_env("REVIEW_DEMO_PASSWORD"),
    notes: normalized_env("REVIEW_NOTES") ||
      "Filmtone Studio is local-first. Review the flow by importing a photo or video, choosing a Look, adjusting controls, comparing the result, then exporting and sharing or saving the output. No login, subscription, AI generation, or cloud sync is required.",
  }.compact
end

def staged_release_screenshot_paths
  SCREENSHOT_LOCALES.each_with_object({}) do |locale, memo|
    memo[locale] = Dir.glob(File.join(SCREENSHOTS_PATH, locale, "*.{png,jpg,jpeg}")).sort
  end
end

def validate_release_screenshots!
  screenshot_paths = staged_release_screenshot_paths
  missing_locales = screenshot_paths.select { |_, paths| paths.empty? }.keys

  unless missing_locales.empty?
    UI.user_error!(
      "Missing staged screenshots for locales: #{missing_locales.join(', ')} under #{SCREENSHOTS_PATH}. Run `fastlane ios screenshots` first."
    )
  end

  counts = screenshot_paths.transform_values(&:count)
  count_summary = counts.map { |locale, count| "#{locale}=#{count}" }.join(", ")

  unless counts.values.all? { |count| count.between?(1, 10) }
    UI.user_error!("Each locale must have between 1 and 10 screenshots. Current counts: #{count_summary}")
  end

  unless counts.values.uniq.one?
    UI.user_error!("Screenshot counts differ by locale: #{count_summary}")
  end

  expected_basenames = nil
  screenshot_paths.each do |locale, paths|
    basenames = paths.map { |path| File.basename(path) }
    expected_basenames ||= basenames
    next if basenames == expected_basenames

    UI.user_error!(
      "Screenshot filenames must match across locales. #{locale} has #{basenames.join(', ')}."
    )
  end

  screenshot_paths
end

def app_store_field_count(text, metric)
  metric == :bytes ? text.bytesize : text.length
end

def validate_ipad_metadata!
  missing = []
  violations = []

  IPAD_SCREENSHOT_LOCALES.each do |locale|
    IPAD_METADATA_REQUIRED_FIELDS.each do |field|
      path = File.join(IPAD_METADATA_TEMPLATE_PATH, locale, "#{field}.txt")
      unless File.exist?(path)
        missing << path
        next
      end

      text = File.read(path).strip
      missing << path if text.empty?

      if (limit = APP_STORE_FIELD_LIMITS[field])
        metric, max = limit
        count = app_store_field_count(text, metric)
        violations << "#{path} exceeds #{max} #{metric}: #{count}" if count > max
      end

      IPAD_FORBIDDEN_COPY_PATTERNS.each do |pattern|
        violations << "#{path} contains forbidden App Store text: #{pattern.source}" if text.match?(pattern)
      end
    end
  end

  Dir.glob(File.join(IPAD_METADATA_TEMPLATE_PATH, "**", "*.txt")).each do |path|
    text = File.read(path)
    IPAD_FORBIDDEN_COPY_PATTERNS.each do |pattern|
      violations << "#{path} contains forbidden App Store text: #{pattern.source}" if text.match?(pattern)
    end
  end

  UI.user_error!("Missing iPad metadata fields: #{missing.join(', ')}") unless missing.empty?
  UI.user_error!("iPad metadata preflight failed:\n#{violations.uniq.join("\n")}") unless violations.empty?

  UI.message("Validated iPad metadata at #{IPAD_METADATA_TEMPLATE_PATH}")
end

def png_dimensions(path)
  File.open(path, "rb") do |file|
    signature = file.read(8)
    UI.user_error!("Expected PNG signature for #{path}") unless signature == "\x89PNG\r\n\x1A\n".b

    file.read(4)
    chunk_type = file.read(4)
    UI.user_error!("Expected IHDR chunk for #{path}") unless chunk_type == "IHDR"

    [file.read(4).unpack1("N"), file.read(4).unpack1("N")]
  end
end

def staged_ipad_screenshot_paths
  IPAD_SCREENSHOT_LOCALES.each_with_object({}) do |locale, memo|
    memo[locale] = Dir.glob(File.join(IPAD_SCREENSHOTS_PATH, locale, "*.png")).sort
  end
end

def validate_ipad_screenshots!
  screenshot_paths = staged_ipad_screenshot_paths
  missing_locales = screenshot_paths.select { |_, paths| paths.empty? }.keys

  unless missing_locales.empty?
    UI.user_error!(
      "Missing iPad screenshots for locales: #{missing_locales.join(', ')} under #{IPAD_SCREENSHOTS_PATH}."
    )
  end

  counts = screenshot_paths.transform_values(&:count)
  count_summary = counts.map { |locale, count| "#{locale}=#{count}" }.join(", ")
  unless counts.values.all? { |count| count == IPAD_SCREENSHOT_COUNT }
    UI.user_error!("Expected #{IPAD_SCREENSHOT_COUNT} iPad screenshots per locale. Current counts: #{count_summary}")
  end

  expected_basenames = nil
  screenshot_paths.each do |locale, paths|
    basenames = paths.map { |path| File.basename(path) }
    expected_basenames ||= basenames
    next if basenames == expected_basenames

    UI.user_error!("iPad screenshot filenames must match across locales. #{locale} has #{basenames.join(', ')}.")
  end

  screenshot_paths.each_value do |paths|
    paths.each do |path|
      width, height = png_dimensions(path)
      next if width == IPAD_SCREENSHOT_WIDTH && height == IPAD_SCREENSHOT_HEIGHT

      UI.user_error!(
        "Invalid iPad screenshot size for #{path}: #{width}x#{height}, expected #{IPAD_SCREENSHOT_WIDTH}x#{IPAD_SCREENSHOT_HEIGHT}."
      )
    end
  end

  UI.message("Validated iPad screenshots at #{IPAD_SCREENSHOTS_PATH}: #{count_summary}")
  screenshot_paths
end

def generate_ipad_asc_screenshots!(screenshot_paths)
  magick_path = command_output!("which", "magick").strip
  FileUtils.rm_rf(IPAD_ASC_SCREENSHOTS_PATH)

  IPAD_ASC_SCREENSHOT_VARIANTS.each_with_object({}) do |(display_type, dimensions), memo|
    memo[display_type] = {}
    IPAD_SCREENSHOT_LOCALES.each do |locale|
      output_dir = File.join(IPAD_ASC_SCREENSHOTS_PATH, display_type, locale)
      FileUtils.mkdir_p(output_dir)
      memo[display_type][locale] = screenshot_paths.fetch(locale).map do |source_path|
        output_path = File.join(output_dir, File.basename(source_path))
        size_arg = "#{dimensions.fetch(:width)}x#{dimensions.fetch(:height)}"
        command_output!(
          magick_path,
          source_path,
          "-alpha",
          "remove",
          "-alpha",
          "off",
          "-colorspace",
          "sRGB",
          "-resize",
          size_arg,
          "-gravity",
          "center",
          "-background",
          IPAD_ASC_SCREENSHOT_PAD_COLOR,
          "-extent",
          size_arg,
          output_path
        )

        width, height = png_dimensions(output_path)
        unless width == dimensions.fetch(:width) && height == dimensions.fetch(:height)
          UI.user_error!(
            "Invalid generated iPad ASC screenshot size for #{output_path}: #{width}x#{height}, expected #{size_arg}."
          )
        end

        output_path
      end
    end
  end
end

def load_asc_spaceship_token!
  UI.user_error!(
    "Set ASC_KEY_ID, ASC_ISSUER_ID, and either ASC_KEY_CONTENT or ASC_KEY_PATH"
  ) unless asc_api_key_configured?

  options = {
    key_id: env!("ASC_KEY_ID"),
    issuer_id: env!("ASC_ISSUER_ID"),
    duration: 1200,
  }

  if (key_content = normalized_env("ASC_KEY_CONTENT"))
    options[:key] = key_content.gsub("\\n", "\n")
  else
    options[:filepath] = File.expand_path(env!("ASC_KEY_PATH"), APP_ROOT)
  end

  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**options)
end

def wait_for_ipad_screenshot_checksums!(client:, set_id:, target_md5s:, locale:, display_type:)
  missing_md5s = target_md5s

  IPAD_SCREENSHOT_SYNC_ATTEMPTS.times do |attempt|
    set = Spaceship::ConnectAPI::AppScreenshotSet.get(client: client, app_screenshot_set_id: set_id)
    screenshots_by_md5 = (set.app_screenshots || []).group_by do |screenshot|
      screenshot.source_file_checksum.to_s
    end
    missing_md5s = target_md5s.reject { |md5| screenshots_by_md5.key?(md5) }
    return [set, screenshots_by_md5] if missing_md5s.empty?

    if attempt + 1 < IPAD_SCREENSHOT_SYNC_ATTEMPTS
      UI.message(
        "Waiting for iPad screenshots to process for #{locale} #{display_type}: #{missing_md5s.length} remaining"
      )
      sleep(IPAD_SCREENSHOT_SYNC_WAIT_SECONDS)
    end
  end

  UI.user_error!(
    "Missing uploaded iPad screenshots for #{locale} #{display_type}: #{missing_md5s.join(', ')}"
  )
end

def upload_ipad_asc_screenshot_sets!(app_version:, screenshot_paths_by_display:)
  load_asc_spaceship_token!
  client = Spaceship::ConnectAPI
  version = target_ipad_app_store_version!(app_version)
  localizations = version.get_app_store_version_localizations(limit: 50)
  localizations_by_locale = localizations.each_with_object({}) do |localization, memo|
    memo[localization.locale] = localization
  end
  missing_locales = IPAD_SCREENSHOT_LOCALES.reject { |locale| localizations_by_locale.key?(locale) }
  UI.user_error!("Missing iPad App Store localizations: #{missing_locales.join(', ')}") unless missing_locales.empty?

  IPAD_SCREENSHOT_LOCALES.each do |locale|
    localization = localizations_by_locale.fetch(locale)
    screenshot_paths_by_display.each do |display_type, paths_by_locale|
      paths = paths_by_locale.fetch(locale)
      target_md5s = paths.map { |path| Digest::MD5.file(path).hexdigest }
      sets = localization.get_app_screenshot_sets(client: client, includes: "appScreenshots", limit: 100)
      set = sets.find { |candidate| candidate.screenshot_display_type == display_type }
      set ||= localization.create_app_screenshot_set(
        client: client,
        attributes: { screenshotDisplayType: display_type }
      )
      set = Spaceship::ConnectAPI::AppScreenshotSet.get(client: client, app_screenshot_set_id: set.id)

      (set.app_screenshots || [])
        .select { |screenshot| target_md5s.include?(screenshot.source_file_checksum.to_s) }
        .each { |screenshot| screenshot.delete!(client: client) }

      paths.each_with_index do |path, index|
        UI.message("Uploading iPad screenshot #{locale} #{display_type} #{index + 1}/#{paths.length}: #{File.basename(path)}")
        set.upload_screenshot(client: client, path: path, wait_for_processing: true)
      end

      set, screenshots_by_md5 = wait_for_ipad_screenshot_checksums!(
        client: client,
        set_id: set.id,
        target_md5s: target_md5s,
        locale: locale,
        display_type: display_type
      )
      screenshots_by_md5.each do |checksum, screenshots|
        keep_count = target_md5s.include?(checksum) ? 1 : 0
        screenshots.drop(keep_count).each { |screenshot| screenshot.delete!(client: client) }
      end

      set, screenshots_by_md5 = wait_for_ipad_screenshot_checksums!(
        client: client,
        set_id: set.id,
        target_md5s: target_md5s,
        locale: locale,
        display_type: display_type
      )

      ordered_ids = target_md5s.map { |md5| screenshots_by_md5.fetch(md5).first.id }
      set.reorder_screenshots(client: client, app_screenshot_ids: ordered_ids)

      final_checksums = []
      IPAD_SCREENSHOT_SYNC_ATTEMPTS.times do |attempt|
        set = Spaceship::ConnectAPI::AppScreenshotSet.get(client: client, app_screenshot_set_id: set.id)
        final_checksums = (set.app_screenshots || []).map { |screenshot| screenshot.source_file_checksum.to_s }
        break if final_checksums == target_md5s
        sleep(IPAD_SCREENSHOT_SYNC_WAIT_SECONDS) if attempt + 1 < IPAD_SCREENSHOT_SYNC_ATTEMPTS
      end
      unless final_checksums == target_md5s
        UI.user_error!(
          "iPad screenshot verification failed for #{locale} #{display_type}: #{final_checksums.join(', ')}"
        )
      end

      UI.message("Verified iPad screenshots for #{locale} #{display_type}")
    end
  end
end

def ipad_app_store_version!
  normalized_env("IPAD_APP_VERSION") ||
    normalized_env("APP_VERSION") ||
    UI.user_error!("Set IPAD_APP_VERSION or APP_VERSION for the iPad release rail")
end

def ipad_app_store_build_number!(options)
  normalized_env("IPAD_BUILD_NUMBER") ||
    normalized_env("BUILD_NUMBER") ||
    options[:build_number] ||
    options["build_number"] ||
    UI.user_error!("Set IPAD_BUILD_NUMBER, BUILD_NUMBER, or pass build_number:")
end

platform :ios do
  desc "Archive Filmtone with Xcode automatic signing and app-store export"
  lane :archive do
    app_version = iphone_archive_version!
    build_number = iphone_archive_build_number!
    output_directory = File.join(BUILD_OUTPUT_DIR, "Filmtone-iPhone-#{app_version}-#{build_number}")
    FileUtils.mkdir_p(output_directory)

    xcargs_parts = [
      "-allowProvisioningUpdates",
      "MARKETING_VERSION=#{app_version}",
      "CURRENT_PROJECT_VERSION=#{build_number}",
    ]
    temp_key_path = nil

    if asc_api_key_configured?
      temp_key_path = resolve_asc_key_file_path! if normalized_env("ASC_KEY_CONTENT")
      key_file_path = temp_key_path || File.expand_path(env!("ASC_KEY_PATH"), APP_ROOT)
      xcargs_parts.concat(
        [
          "-authenticationKeyIssuerID", env!("ASC_ISSUER_ID"),
          "-authenticationKeyID", env!("ASC_KEY_ID"),
          "-authenticationKeyPath", key_file_path,
        ]
      )
    end

    UI.important("Archiving iPhone #{app_version} (#{build_number}) for #{APP_IDENTIFIER}.")
    xcargs = xcargs_parts.map(&:shellescape).join(" ")

    begin
      build_app(
        workspace: IOS_WORKSPACE,
        scheme: "App",
        clean: true,
        export_method: "app-store",
        output_directory: output_directory,
        output_name: "Filmtone",
        build_path: output_directory,
        xcargs: xcargs,
        export_options: {
          method: "app-store",
          signingStyle: "automatic",
          teamID: DEVELOPMENT_TEAM_ID,
        }
      )
    ensure
      FileUtils.rm_f(temp_key_path) if temp_key_path
    end
    verify_ipa_identity!(File.join(output_directory, "Filmtone.ipa"), IPHONE_IPA_IDENTITY)
  end

  desc "Capture App Store screenshots with a deterministic UI test rail"
  lane :screenshots do
    UI.message(
      "Capturing common App Store assets from locale #{snapshot_capture_locale} on #{SCREENSHOT_SIMULATOR_DEVICE} (#{SCREENSHOT_SIMULATOR_UDID}) and staging them for #{SCREENSHOT_LOCALES.join(', ')}."
    )
    run_snapshot_ui_test!(locale: snapshot_capture_locale)
    stage_screenshots_for_release!(SCREENSHOT_SIMULATOR_DEVICE)
    validate_release_screenshots!
  end

  desc "Upload localized App Store metadata and review info"
  lane :metadata do
    upload_to_app_store(
      api_key: load_asc_api_key!,
      app_version: app_store_version_number!,
      metadata_path: stage_metadata!,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      precheck_include_in_app_purchases: false,
      copyright: File.read(File.join(METADATA_TEMPLATE_PATH, "copyright.txt")).strip,
      support_url: localized_support_urls,
      marketing_url: localized_marketing_urls,
      privacy_url: localized_privacy_urls,
      app_review_information: app_review_information!,
      submission_information: {
        export_compliance_uses_encryption: false,
      },
      **localized_store_metadata_options
    )
  end

  desc "Upload only localized What's New release notes"
  lane :release_notes do
    load_asc_api_key!
    version = target_app_store_version!(app_store_version_number!)
    UI.message("Updating only What's New for #{APP_IDENTIFIER} #{version.version_string} (#{version.app_version_state})")
    sync_release_notes_only!(version: version)
  end

  desc "Archive Filmtone Studio from the native App-iPad target"
  lane :ipad_archive do |options|
    FileUtils.mkdir_p(BUILD_OUTPUT_DIR)

    app_version = ipad_app_store_version!
    build_number = ipad_app_store_build_number!(options)
    output_directory = File.join(BUILD_OUTPUT_DIR, "Filmtone-iPad-#{app_version}-#{build_number}")
    FileUtils.mkdir_p(output_directory)

    xcargs_parts = [
      "-allowProvisioningUpdates",
      "MARKETING_VERSION=#{app_version}",
      "CURRENT_PROJECT_VERSION=#{build_number}",
    ]
    temp_key_path = nil

    if asc_api_key_configured?
      temp_key_path = resolve_asc_key_file_path! if normalized_env("ASC_KEY_CONTENT")
      key_file_path = temp_key_path || File.expand_path(env!("ASC_KEY_PATH"), APP_ROOT)
      xcargs_parts.concat(
        [
          "-authenticationKeyIssuerID", env!("ASC_ISSUER_ID"),
          "-authenticationKeyID", env!("ASC_KEY_ID"),
          "-authenticationKeyPath", key_file_path,
        ]
      )
    end

    UI.important("Archiving native App-iPad #{app_version} (#{build_number}) for #{IPAD_APP_IDENTIFIER}.")
    xcargs = xcargs_parts.map(&:shellescape).join(" ")

    begin
      build_app(
        workspace: IOS_WORKSPACE,
        scheme: "App-iPad",
        clean: true,
        export_method: "app-store",
        output_directory: output_directory,
        output_name: IPAD_OUTPUT_NAME,
        build_path: output_directory,
        xcargs: xcargs,
        export_options: {
          method: "app-store-connect",
          manageAppVersionAndBuildNumber: false,
          signingStyle: "automatic",
          teamID: DEVELOPMENT_TEAM_ID,
        }
      )
    ensure
      FileUtils.rm_f(temp_key_path) if temp_key_path
    end
    verify_ipa_identity!(File.join(output_directory, "#{IPAD_OUTPUT_NAME}.ipa"), IPAD_IPA_IDENTITY)
  end

  desc "Validate staged Filmtone Studio App Store assets without uploading"
  lane :ipad_preflight do
    validate_ipad_metadata!
    validate_ipad_screenshots!
    UI.success("iPad preflight passed for #{IPAD_APP_IDENTIFIER}. No upload was performed.")
  end

  desc "Upload Filmtone Studio metadata and screenshots without binary or review submission"
  lane :ipad_upload_assets do
    validate_ipad_metadata!
    screenshot_paths = validate_ipad_screenshots!
    asc_screenshot_paths = generate_ipad_asc_screenshots!(screenshot_paths)

    app_version = ipad_app_store_version!
    UI.important(
      "Uploading Filmtone Studio App Store assets for #{IPAD_APP_IDENTIFIER} #{app_version}. No binary upload or review submission will be performed."
    )

    upload_to_app_store(
      api_key: load_asc_api_key!,
      app_identifier: IPAD_APP_IDENTIFIER,
      app_version: app_version,
      platform: "ios",
      metadata_path: IPAD_METADATA_TEMPLATE_PATH,
      languages: IPAD_SCREENSHOT_LOCALES,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false,
      copyright: File.read(File.join(IPAD_METADATA_TEMPLATE_PATH, "copyright.txt")).strip,
      submission_information: {
        export_compliance_uses_encryption: false,
      }
    )

    upload_ipad_asc_screenshot_sets!(
      app_version: app_version,
      screenshot_paths_by_display: asc_screenshot_paths
    )
  end

  desc "Upload Filmtone Studio binary, metadata, and screenshots to App Store Connect"
  lane :ipad_release do |options|
    ipa_path = explicit_ipad_ipa_path!(options, lane: "ipad_release")
    validate_ipad_metadata!
    screenshot_paths = validate_ipad_screenshots!
    asc_screenshot_paths = generate_ipad_asc_screenshots!(screenshot_paths)

    app_version = ipad_app_store_version!
    UI.important("Uploading Filmtone Studio #{app_version} for #{IPAD_APP_IDENTIFIER}.")
    UI.user_error!(
      "SUBMIT_FOR_REVIEW=1 is not supported in ipad_release. Run ipad_release first, then ipad_submit_review after the build has processed."
    ) if truthy_env?("SUBMIT_FOR_REVIEW")

    upload_to_app_store(
      api_key: load_asc_api_key!,
      app_identifier: IPAD_APP_IDENTIFIER,
      app_version: app_version,
      ipa: ipa_path,
      platform: "ios",
      metadata_path: IPAD_METADATA_TEMPLATE_PATH,
      languages: IPAD_SCREENSHOT_LOCALES,
      skip_binary_upload: false,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: truthy_env?("AUTOMATIC_RELEASE"),
      force: true,
      precheck_include_in_app_purchases: false,
      copyright: File.read(File.join(IPAD_METADATA_TEMPLATE_PATH, "copyright.txt")).strip,
      release_notes: localized_ipad_release_note_texts,
      app_review_information: ipad_app_review_information!,
      submission_information: {
        export_compliance_uses_encryption: false,
      }
    )

    upload_ipad_asc_screenshot_sets!(
      app_version: app_version,
      screenshot_paths_by_display: asc_screenshot_paths
    )
  end

  desc "Upload Filmtone Studio build to TestFlight"
  lane :ipad_beta do |options|
    ipa_path = explicit_ipad_ipa_path!(options, lane: "ipad_beta")
    upload_options = {
      api_key: load_asc_api_key!,
      app_identifier: IPAD_APP_IDENTIFIER,
      ipa: ipa_path,
      app_platform: "ios",
      skip_waiting_for_build_processing: truthy_env?("SKIP_WAITING_FOR_BUILD_PROCESSING"),
      distribute_external: false,
      notify_external_testers: false,
    }
    build_release_notes = localized_ipad_build_release_notes
    upload_options[:localized_build_info] = build_release_notes unless build_release_notes.empty?

    upload_to_testflight(**upload_options)
  end

  desc "Submit an already uploaded Filmtone Studio build without touching screenshots or binary"
  lane :ipad_submit_review do |options|
    app_version = ipad_app_store_version!
    build_number = ipad_app_store_build_number!(options)
    api_key = load_asc_api_key!

    version = target_ipad_app_store_version!(app_version)
    UI.message("Syncing iPad What's New before review submission for #{IPAD_APP_IDENTIFIER} #{version.version_string}")
    sync_ipad_release_notes_only!(version: version)
    sync_review_release_type!(version: version)

    upload_to_app_store(
      api_key: api_key,
      app_identifier: IPAD_APP_IDENTIFIER,
      app_version: app_version,
      build_number: build_number,
      platform: "ios",
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: truthy_env?("AUTOMATIC_RELEASE"),
      force: true,
      precheck_include_in_app_purchases: false,
      app_review_information: ipad_app_review_information!,
      submission_information: {
        export_compliance_uses_encryption: false,
      }
    )
  end

  desc "Upload only the App Store binary without metadata or screenshots"
  lane :release_binary do |options|
    ipa_path = explicit_ipa_path!(options, lane: "release_binary")
    upload_to_app_store(
      api_key: load_asc_api_key!,
      app_identifier: APP_IDENTIFIER,
      app_version: app_store_version_number!,
      ipa: ipa_path,
      platform: "ios",
      skip_binary_upload: false,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        export_compliance_uses_encryption: false,
      }
    )
  end

  desc "Submit the current build after syncing only What's New release notes"
  lane :submit_review_release_notes do
    api_key = load_asc_api_key!
    version = target_app_store_version!(app_store_version_number!)
    UI.message("Syncing only What's New before review submission for #{APP_IDENTIFIER} #{version.version_string}")
    sync_release_notes_only!(version: version)
    sync_review_release_type!(version: version)

    upload_to_app_store(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: app_store_version_number!,
      build_number: app_store_build_number!,
      platform: "ios",
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: truthy_env?("AUTOMATIC_RELEASE"),
      force: true,
      precheck_include_in_app_purchases: false,
      app_review_information: app_review_information!,
      submission_information: {
        export_compliance_uses_encryption: false,
      }
    )
  end

  desc "Upload an archive to TestFlight"
  lane :beta do |options|
    ipa_path = explicit_ipa_path!(options, lane: "beta")
    upload_options = {
      api_key: load_asc_api_key!,
      ipa: ipa_path,
      app_platform: "ios",
      skip_waiting_for_build_processing: truthy_env?("SKIP_WAITING_FOR_BUILD_PROCESSING"),
      distribute_external: false,
      notify_external_testers: false,
    }
    build_release_notes = localized_build_release_notes
    upload_options[:localized_build_info] = build_release_notes unless build_release_notes.empty?

    upload_to_testflight(**upload_options)
  end

  desc "Upload the app-store build, metadata, and screenshots to App Store Connect"
  lane :release do |options|
    ipa_path = explicit_ipa_path!(options, lane: "release")
    validate_release_screenshots!
    upload_options = {
      api_key: load_asc_api_key!,
      app_version: app_store_version_number!,
      ipa: ipa_path,
      metadata_path: stage_metadata!,
      skip_binary_upload: false,
      skip_metadata: false,
      submit_for_review: truthy_env?("SUBMIT_FOR_REVIEW"),
      automatic_release: truthy_env?("AUTOMATIC_RELEASE"),
      force: true,
      precheck_include_in_app_purchases: false,
      copyright: File.read(File.join(METADATA_TEMPLATE_PATH, "copyright.txt")).strip,
      support_url: localized_support_urls,
      marketing_url: localized_marketing_urls,
      privacy_url: localized_privacy_urls,
      app_review_information: app_review_information!,
      submission_information: {
        export_compliance_uses_encryption: false,
      },
      screenshots_path: SCREENSHOTS_PATH,
      skip_screenshots: false,
      overwrite_screenshots: truthy_env?("OVERWRITE_SCREENSHOTS"),
      **localized_store_metadata_options
    }

    upload_to_app_store(**upload_options)
  end

  desc "Submit an already uploaded App Store Connect build without touching screenshots or binary"
  lane :submit_review do |options|
    app_version = normalized_env("APP_VERSION") || options[:app_version]
    build_number = normalized_env("BUILD_NUMBER") || options[:build_number]

    UI.user_error!("Set APP_VERSION or pass app_version:") unless app_version
    UI.user_error!("Set BUILD_NUMBER or pass build_number:") unless build_number

    upload_to_app_store(
      api_key: load_asc_api_key!,
      app_identifier: APP_IDENTIFIER,
      app_version: app_version,
      build_number: build_number,
      platform: "ios",
      metadata_path: stage_metadata!,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: true,
      automatic_release: truthy_env?("AUTOMATIC_RELEASE"),
      force: true,
      precheck_include_in_app_purchases: false,
      copyright: File.read(File.join(METADATA_TEMPLATE_PATH, "copyright.txt")).strip,
      support_url: localized_support_urls,
      marketing_url: localized_marketing_urls,
      privacy_url: localized_privacy_urls,
      app_review_information: app_review_information!,
      submission_information: {
        export_compliance_uses_encryption: false,
      },
      **localized_store_metadata_options
    )
  end
end
