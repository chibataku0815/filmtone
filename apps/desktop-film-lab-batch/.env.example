# Film Lab Desktop — 環境例（このファイルに秘密鍵は書かない。コピーして `.env` にrename）
#
# 共有 BFF（apps/web）のオリジン。ローカル build+start でもデプロイ URL でもよい。末尾スラッシュなし。
VITE_FILM_LAB_API_ORIGIN=http://127.0.0.1:3000
#
# スマートルック UI（ControlPanel 内）— ペンディング中は false。再開時に true
VITE_FILM_LAB_SMART_LOOK_UI=false
#
# 支援者 Cookie が無い環境だけ（動作確認用）。本番相当の検証では false
VITE_FILM_LAB_ASSUME_SUPPORTER=true
#
# ラスタ MVP（BFF の POST includeRasterCorrection と揃える）
VITE_FILM_LAB_SMART_LOOK_RASTER=true
