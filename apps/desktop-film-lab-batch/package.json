{
  "name": "desktop-film-lab-batch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "packageManager": "bun@1.3.3",
  "scripts": {
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.cjs --external:electron && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron",
    "build:renderer": "vite build",
    "build": "bun run build:electron && bun run build:renderer",
    "dev": "bun run build:electron && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist-electron/main.cjs\""
  },
  "dependencies": {
    "@radix-ui/colors": "^3.0.0",
    "film-lab-core": "workspace:*",
    "next-intl": "^4.8.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "three": "^0.181.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^35.1.4",
    "esbuild": "^0.25.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^4",
    "typescript": "^5.7.2",
    "vite": "^6.2.4",
    "wait-on": "^8.0.3"
  }
}
