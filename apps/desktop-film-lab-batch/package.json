{
  "name": "desktop-film-lab-batch",
  "version": "0.1.0",
  "private": true,
  "description": "Film Lab — local batch grading (Electron)",
  "author": "chibatakumi",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "packageManager": "bun@1.3.3",
  "scripts": {
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.cjs --external:electron && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron",
    "build:renderer": "vite build",
    "build": "bun run build:electron && bun run build:renderer",
    "test": "vitest run --config vitest.config.ts",
    "test:smart-look-pending": "vitest run --config vitest.config.ts src/renderer/desktop-smart-look-pending.test.ts",
    "desktop": "bun run build:electron && concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env FILM_LAB_DESKTOP_RENDERER_URL=http://127.0.0.1:5173 electron dist-electron/main.cjs\"",
    "desktop:with-bff": "concurrently -k -n bff,film-lab \"cd ../web && bun run bff:local\" \"wait-on -t 120000 http://127.0.0.1:3000 && bun run desktop\"",
    "dev": "bun run desktop",
    "start": "bun run build && electron dist-electron/main.cjs",
    "pack:mac": "bun run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir",
    "dist:mac": "bun run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/colors": "^3.0.0",
    "electron-store": "8.2.0",
    "film-lab-core": "workspace:*",
    "film-lab-smart-look": "workspace:*",
    "next-intl": "^4.8.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "three": "^0.181.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^35.1.4",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^4",
    "typescript": "^5.7.2",
    "vite": "^6.2.4",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.chibatakumi.film-lab-desktop",
    "productName": "Film Lab",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.photography",
      "icon": "resources/film-lab-icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    }
  }
}
